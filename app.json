{
  "expo": {
    "name": "proyecto-integrador-mobile",
    "slug": "proyecto-integrador-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/asisco-icon.png",
    "scheme": "proyectointegradormobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/asisco-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6B65",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/asisco-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F6B65",
          "image": "./assets/images/asisco-splash.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

        {
          "name": "Login · Acudiente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json.token || json.accessToken || (json.data && json.data.token);",
                  "if (token) {",
                  "  pm.collectionVariables.set('token', token);",
                  "}",
                  "pm.test('responde 200 con token', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(token).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{url}}/auth/login",
              "host": ["{{url}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@prueba.com\",\n  \"clave\": \"ClaveAcudiente2026\"\n}",
              "options": {
